{
  "compilerOptions": {
    "target": "es2020" /* Set the target JavaScript language version */,
    "module": "commonjs" /* Use CommonJS module system for Node.js */,
    "rootDir": "./src" /* Specify the root directory of input files */,
    "outDir": "./dist" /* Specify the output directory for compiled JS */,
    "typeRoots": ["./src/types", "./node_modules/@types"],

    "esModuleInterop": true /* Allow default imports from modules with no default export (critical for Express) */,
    "resolveJsonModule": true /* Include modules imported via JSON files */,
    "forceConsistentCasingInFileNames": true,

    "strict": true /* Enable all strict type-checking options */,
    "skipLibCheck": true /* Skip type checking of declaration files */,

    "isolatedModules": false,
    "verbatimModuleSyntax": false,
    "moduleDetection": "auto"
  },
  "include": ["src/**/*"] /* Include all files in the src folder */,
  "exclude": ["node_modules", "dist"] /* Exclude directories */
}
